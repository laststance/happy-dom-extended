{
  "name": "jest-happy-dom-extended",
  "version": "0.2.2",
  "description": "A Happy DOM Jest environment with real 2D Canvas, dedicated Workers, and verified Web API compatibility fixes.",
  "keywords": [
    "jest",
    "jest-environment",
    "happy-dom",
    "canvas",
    "offscreencanvas",
    "skia",
    "web-worker",
    "dom",
    "testing"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ryota-murakami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laststance/happy-dom-extended.git",
    "directory": "packages/jest-happy-dom-extended"
  },
  "homepage": "https://github.com/laststance/happy-dom-extended/tree/main/packages/jest-happy-dom-extended#readme",
  "bugs": {
    "url": "https://github.com/laststance/happy-dom-extended/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/dts-sourcemap.mjs",
    "check:package": "publint && attw --pack --profile node16 && node ../../scripts/dts-sourcemap.mjs --check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@happy-dom/jest-environment": "20.14.5",
    "buffer-image-size": "0.6.4",
    "culori": "4.0.2",
    "happy-dom": "20.14.5",
    "skia-canvas": "3.0.8",
    "webidl-conversions": "8.0.1"
  },
  "peerDependencies": {
    "jest": "^30.0.0"
  },
  "devDependencies": {
    "@happy-dom-extended/compat": "workspace:*",
    "@jest/environment": "30.5.2",
    "@jest/globals": "30.5.2",
    "@jest/types": "30.5.1",
    "fast-check": "4.10.2"
  }
}
