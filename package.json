{
  "name": "happy-dom-extended",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter jest-happy-dom-extended build",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --concurrency=auto --max-warnings=0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm test:unit && pnpm test:jest",
    "test:unit": "node --test packages/compat/test/*.test.ts",
    "test:jest": "jest --runInBand --no-cache",
    "sherif": "sherif",
    "health": "fallow health --fail-on-issues",
    "dupes": "fallow dupes --fail-on-issues",
    "dead-code": "fallow dead-code --fail-on-issues",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "check:package": "pnpm --filter jest-happy-dom-extended check:package",
    "check": "pnpm sherif && pnpm format:check && pnpm test && pnpm lint && pnpm typecheck && pnpm health && pnpm dupes && pnpm dead-code && pnpm check:package && pnpm test:package",
    "release": "pnpm check && changeset publish",
    "probe:upstream": "node packages/compat/test/upstream-probe.ts",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.2",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/node": "^22.0.0",
    "eslint": "10.10.0",
    "eslint-config-ts-prefixer": "5.0.0",
    "fallow": "3.22.0",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "sherif": "1.13.0",
    "tsdown": "0.23.0",
    "typescript": "~6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2"
  }
}
