{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/*/src/index.ts",
    "packages/*/src/worker.ts",
    "packages/vitest-happy-dom-extended/src/global-setup.ts",
    "packages/compat/src/workers/worker-bootstrap.ts",
    "packages/*/tsdown.config.ts",
    "packages/*/test/**/*.test.ts",
    "packages/compat/test/upstream-probe.ts",
    "fixtures/consumer/*.cjs",
    "fixtures/consumer/*.mjs",
    "fixtures/consumer-vitest/*.mjs",
    "fixtures/consumer-vitest-product/vitest.config.ts",
    "fixtures/consumer-vitest-product/src/test/setup.ts",
    "fixtures/consumer-vitest-product/src/**/*.test.tsx",
    "packages/*/test-node/*.test.mjs",
    "packages/*/vitest.config.ts"
  ],
  "ignorePatterns": [".artifacts/**"],
  "health": {
    "ignore": ["**/test/**", "**/test-node/**"],
    "coverage": "coverage/coverage-final.json"
  },
  "duplicates": {
    "ignore": ["**/test/**", "**/test-node/**"]
  },
  "framework": [
    {
      "name": "repository-tools",
      "entryPoints": ["scripts/*.mjs"],
      "entryPointRole": "support",
      "toolingDependencies": ["typescript-compiler"]
    }
  ],
  "usedClassMembers": [
    {
      "implements": "ICanvasAdapter",
      "members": ["getContext", "toDataURL", "toBlob"]
    }
  ],
  "ignoreDependencies": [
    "happy-dom",
    "buffer-image-size",
    "culori",
    "skia-canvas",
    "webidl-conversions"
  ]
}
